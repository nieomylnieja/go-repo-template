{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'schedule:nonOfficeHours',
    ':enableVulnerabilityAlertsWithLabel(security)',
    'group:recommended',
    'workarounds:all',
    ':preserveSemverRanges',
    ':automergeMinor',
    ':automergePr',
    ':automergeRequireAllStatusChecks',
  ],
  reviewersFromCodeOwners: true,
  dependencyDashboard: {
    enabled: true,
  },
  semanticCommits: 'disabled',
  labels: [
    'dependencies',
    'renovate',
  ],
  prHourlyLimit: 1,
  prConcurrentLimit: 5,
  rebaseWhen: 'conflicted',
  rangeStrategy: 'pin',
  branchPrefix: 'renovate_',
  commitMessagePrefix: 'chore:',
  postUpdateOptions: [
    'gomodTidy',
  ],
  packageRules: [
    {
      matchManagers: [
        'gomod',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      groupName: 'minor and patch Golang dependencies',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      addLabels: [
        'github-actions',
      ],
    },
    {
      matchManagers: [
        'gomod',
      ],
      addLabels: [
        'golang',
      ],
    },
    {
      matchManagers: [
        'npm',
      ],
      addLabels: [
        'javascript',
      ],
    },
  ],
  ignorePaths: [
    '**/vendor/**',
    '**/node_modules/**',
  ],
}
